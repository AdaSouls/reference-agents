# Koios. Public mainnet endpoint works without a key (rate-limited).
KOIOS_BASE_URL=https://api.koios.rest/api/v1
KOIOS_API_KEY=

# Where ingested data lives. Keep it out of git (see .gitignore).
DATA_DIR=./data

# ipfs:// anchors are fetched through these gateways, in order, until one
# serves the content (public gateways rate-limit with HTTP 429). Untrusted
# like any host: the bytes must still hash to the on-chain anchor hash.
# Unset = recorded as unavailable.
IPFS_GATEWAY=https://ipfs.io/ipfs/,https://dweb.link/ipfs/,https://gateway.pinata.cloud/ipfs/,https://w3s.link/ipfs/

# Other URLs for the same Constitution bytes, tried after the anchor URL
# fails (comma-separated). As untrusted as any host: the hash decides.
CONSTITUTION_MIRRORS=https://raw.githubusercontent.com/IntersectMBO/cardano-constitution/main/cardano-constitution-2/cardano-constitution-2.txt

# Anchor download limits.
ANCHOR_MAX_BYTES=2000000
ANCHOR_TIMEOUT_MS=20000

# The analysis (gov analyse). The key is read by the Anthropic SDK; never printed.
ANTHROPIC_API_KEY=
ANALYSIS_MODEL=claude-sonnet-4-5
# A rejected answer (bad JSON, unsourced figure, unknown citation) goes back to the model with the
# exact problems, up to this many answers in total. The checks themselves never relax.
ANALYSIS_MAX_ATTEMPTS=3
# Conflict-of-interest policy text given to the model: a file (cardano-governance/policies/conflict-of-interest.md)
# or, failing that, a comma-separated list of parties/topics.
CONFLICT_OF_INTEREST_POLICY=../../cardano-governance/policies/conflict-of-interest.md
COI_TERMS=AdaSouls,ALDEA World,SOULS stake pool
# Where the published analysis will live; {key} is replaced with <tx>-<ix>.
ANALYSIS_URL_TEMPLATE=https://github.com/AdaSouls/cardano-governance/blob/main/votes/{key}/analysis.md

# The analysis key (gov review signs with it): Ed25519, PKCS#8, made with `gov keygen`.
# Signs records only; moves nothing. Keep it out of git. Never printed.
ANALYSIS_KEY_FILE=

# Publishing (gov publish / gov anchor): a checkout of AdaSouls/cardano-governance.
GOVERNANCE_DIR=../../cardano-governance
GOVERNANCE_REPO=AdaSouls/cardano-governance
