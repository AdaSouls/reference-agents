# Koios. Public mainnet endpoint works without a key (rate-limited).
KOIOS_BASE_URL=https://api.koios.rest/api/v1
KOIOS_API_KEY=

# Where ingested data lives. Keep it out of git (see .gitignore).
DATA_DIR=./data

# ipfs:// anchors are fetched through this gateway. Untrusted like any host:
# the bytes must still hash to the on-chain anchor hash. Unset = recorded as unavailable.
IPFS_GATEWAY=https://ipfs.io/ipfs/

# Anchor download limits.
ANCHOR_MAX_BYTES=2000000
ANCHOR_TIMEOUT_MS=20000

# Later phases (G1.3+). Never printed.
ANTHROPIC_API_KEY=
ANALYSIS_KEY_FILE=
