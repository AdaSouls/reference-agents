# Runtime (the agent itself -- src/index.ts, only ever uses @adasouls/sdk).
# Fill these in with `npm run setup`'s printed output.
ADASOULS_API_URL=http://localhost:3000/v1
ADASOULS_API_KEY=
AGENT_ID=
VENDOR_AGENT_ID=agent_demo_vendor

# Paying from the agent's own wallet (src/pay-from-wallet.ts), for an agent
# whose wallet is connected in "self" mode. Base Sepolia USDC.
AGENT_WALLET_PRIVATE_KEY=
BASE_SEPOLIA_RPC_URL=
# The guarded wallet's payment records. Must survive restarts: losing it
# between sending and reporting is what would pay twice.
PAYMENTS_DIR=.adasouls/payments
# Names one payment: rerunning with the same id finishes it instead of paying again. Defaults to today's date.
PAYMENT_RUN_ID=

# Setup only (src/setup.ts -- a real Auth0 token, see that file's header
# comment for how to get one). Not needed once ADASOULS_API_KEY/AGENT_ID
# above are filled in.
AUTH0_TOKEN=
